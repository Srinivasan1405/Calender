# Port the Express server listens on
PORT=8080

# Local: mongodb://localhost:27017/routine_tracker
# Production (MongoDB Atlas free tier): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/routine_tracker
MONGO_URI=mongodb://localhost:27017/routine_tracker

# Sign any long random string. Required in production.
JWT_SECRET=change_me_to_a_long_random_string

# Optional. Without it the chat route falls back to canned replies.
OPENAI_API_KEY=
